    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    v.id                                    AS venta_id,\n    cl.nombre                               AS cliente,\n    v.fecha::DATE                           AS fecha,\n    v.total,\n    STRING_AGG(p.nombre || ' (x' || dv.cantidad || ')', ', ') AS productos\nFROM ventas v\nJOIN clientes cl      ON cl.id = v.cliente_id\nJOIN detalle_venta dv ON dv.venta_id = v.id\nJOIN productos p      ON p.id = dv.producto_id\nGROUP BY v.id, cl.nombre, v.fecha, v.total\nORDER BY v.fecha DESC\nLIMIT 10;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "907db780-346b-4322-b369-fcafec72154a",
      "name": "Execute a SQL query",
      "credentials": {
        "postgres": {
          "id": "9VBZqOBt6WDgRTdn",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst totalGeneral = items.reduce((sum, i) => sum + parseFloat(i.json.total), 0);\n\nconst filasHTML = items.map(i => `\n    <tr>\n        <td>#${i.json.venta_id}</td>\n        <td>${i.json.cliente}</td>\n        <td>${i.json.fecha}</td>\n        <td>${i.json.productos}</td>\n        <td><b>Q${parseFloat(i.json.total).toFixed(2)}</b></td>\n    </tr>\n`).join('');\n\nconst telegramMsg = ` Historial de ventas\n\nTotal ventas: ${items.length}\nTotal ingresos: Q${totalGeneral.toFixed(2)}\n\nÚltimas ventas:\n${items.map(i => \n    ` #${i.json.venta_id} | ${i.json.cliente}\\n   ${i.json.productos}\\n   Total: Q${parseFloat(i.json.total).toFixed(2)} | ${i.json.fecha}`\n).join('\\n\\n')}`;\n\nreturn [{\n    json: {\n        total_ventas: items.length,\n        total_general: totalGeneral.toFixed(2),\n        filas_html: filasHTML,\n        telegram: telegramMsg\n    }\n}];"
      },
