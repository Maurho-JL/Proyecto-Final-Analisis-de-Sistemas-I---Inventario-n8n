    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst filas = items.map(i =>\n  `<tr>\n    <td>${i.json.cliente}</td>\n    <td>Q${i.json.total}</td>\n    <td>${i.json.fecha}</td>\n    <td style=\"color:red\"><b>${i.json.cantidad_ventas}</b></td>\n  </tr>`\n).join('');\n\nconst telegramMsg = ` Ventas Duplicadas Detectadas\n${new Date().toLocaleDateString('es-GT')}\n\nSe encontraron ${items.length} posibles duplicados:\n\n${items.map(i =>\n  ` ${i.json.cliente}\\n   Total: Q${i.json.total} | Repetidas: ${i.json.cantidad_ventas}x`\n).join('\\n')}\n\nRevisar en el sistema urgente.`;\n\nreturn [{\n  json: {\n    total: items.length,\n    tabla: filas,\n    telegram: telegramMsg\n  }\n}];"
      },
