    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    c.nombre        AS cliente,\n    v.id            AS venta_id,\n    v.fecha::DATE   AS fecha,\n    v.total,\n    json_agg(json_build_object(\n        'producto', p.nombre,\n        'cantidad', dv.cantidad,\n        'precio',   dv.precio_unitario,\n        'subtotal', dv.cantidad * dv.precio_unitario\n    )) AS detalle\nFROM ventas v\nJOIN clientes cl      ON cl.id = v.cliente_id\nJOIN detalle_venta dv ON dv.venta_id = v.id\nJOIN productos p      ON p.id = dv.producto_id\nJOIN clientes c       ON c.id = v.cliente_id\nWHERE v.id = {{ $json.body.venta_id }}\nGROUP BY c.nombre, v.id, v.fecha, v.total;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "f4a914e1-a416-4d8c-b26e-49de92dcca27",
      "name": "Execute a SQL query",
