    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    c.id,\n    c.nombre,\n    c.creado_en::DATE           AS cliente_desde,\n    COUNT(v.id)                 AS total_compras,\n    COALESCE(SUM(v.total), 0)  AS total_gastado\nFROM clientes c\nLEFT JOIN ventas v ON v.cliente_id = c.id\nWHERE \n    c.id::TEXT = '{{ $json.query.buscar }}'\n    OR c.nombre ILIKE '%{{ $json.query.buscar }}%'\nGROUP BY c.id, c.nombre, c.creado_en\nORDER BY c.nombre;",
        "options": {}
      },
