        "query": "SET search_path TO inventario;\n\nWITH precio_anterior AS (\n    SELECT precio_venta AS precio_old\n    FROM productos\n    WHERE codigo = '{{ $json.body.codigo }}'\n)\nUPDATE productos \nSET precio_venta = {{ $json.body.precio_venta }}\nWHERE codigo = '{{ $json.body.codigo }}'\nRETURNING \n    id,\n    codigo,\n    nombre,\n    precio_venta AS precio_nuevo,\n    (SELECT precio_old FROM precio_anterior) AS precio_anterior,\n    actualizado_en;",
        "options": {}
      },
