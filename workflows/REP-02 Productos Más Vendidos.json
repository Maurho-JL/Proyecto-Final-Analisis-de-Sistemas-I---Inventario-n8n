    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    p.codigo,\n    p.nombre                        AS producto,\n    c.nombre                        AS categoria,\n    SUM(dv.cantidad)                AS unidades_vendidas,\n    COUNT(DISTINCT dv.venta_id)     AS aparece_en_ventas,\n    SUM(dv.cantidad * dv.precio_unitario) AS ingresos_generados,\n    p.stock_actual                  AS stock_disponible\nFROM detalle_venta dv\nJOIN productos p  ON p.id = dv.producto_id\nJOIN categorias c ON c.id = p.categoria_id\nJOIN ventas v     ON v.id = dv.venta_id\nWHERE DATE_TRUNC('month', v.fecha) = DATE_TRUNC('month', CURRENT_DATE)\nGROUP BY p.id, p.codigo, p.nombre, c.nombre, p.stock_actual\nORDER BY unidades_vendidas DESC\nLIMIT 10;",
        "options": {}
      },
