      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nWITH nueva_entrada AS (\n    INSERT INTO entradas (producto_id, proveedor_id, cantidad, costo_unitario, notas)\n    VALUES (\n        {{ $json.body.producto_id }},\n        {{ $json.body.proveedor_id }},\n        {{ $json.body.cantidad }},\n        {{ $json.body.costo_unitario }},\n        '{{ $json.body.notas }}'\n    )\n    RETURNING id, producto_id, proveedor_id, cantidad, costo_unitario, notas, fecha\n)\nSELECT \n    e.id,\n    e.producto_id,\n    p.nombre AS nombre_producto,\n    e.proveedor_id,\n    e.cantidad,\n    e.costo_unitario,\n    e.notas,\n    e.fecha\nFROM nueva_entrada e\nJOIN productos p ON p.id = e.producto_id;",
        "options": {}
      },
