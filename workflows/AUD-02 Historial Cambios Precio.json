    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    lp.id,\n    p.codigo,\n    p.nombre            AS producto,\n    c.nombre            AS categoria,\n    lp.precio_anterior,\n    lp.precio_nuevo,\n    ROUND(lp.precio_nuevo - lp.precio_anterior, 2) AS diferencia,\n    ROUND(\n        (lp.precio_nuevo - lp.precio_anterior) * 100.0 \n        / NULLIF(lp.precio_anterior, 0), 2\n    )                   AS cambio_porcentaje,\n    lp.fecha::DATE      AS fecha\nFROM log_precios lp\nJOIN productos p  ON p.id = lp.producto_id\nJOIN categorias c ON c.id = p.categoria_id\nORDER BY lp.fecha DESC;",
        "options": {}
      },
