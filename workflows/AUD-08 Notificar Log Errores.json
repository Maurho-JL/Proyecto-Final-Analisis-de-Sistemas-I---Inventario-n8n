{
  "name": "AUD-12 Notificar Log Errores",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst pendientes = items.filter(i => i.json.estado === 'pendiente').length;\nconst resueltas = items.filter(i => i.json.estado === 'resuelta').length;\n\nconst filasHTML = items.map(i => `\n    <tr>\n        <td>${i.json.id}</td>\n        <td>${i.json.codigo}</td>\n        <td>${i.json.producto}</td>\n        <td>${i.json.tipo_alerta}</td>\n        <td>${i.json.mensaje}</td>\n        <td>${i.json.estado}</td>\n        <td>${i.json.fecha}</td>\n    </tr>\n`).join('');\n\nconst telegramMsg = ` Log de errores del sistema\n${new Date().toLocaleDateString('es-GT')}\n\nTotal alertas: ${items.length}\nPendientes: ${pendientes}\nResueltas: ${resueltas}\n\nAlertas pendientes:\n${items.filter(i => i.json.estado === 'pendiente').slice(0,5).map(i =>\n    ` ${i.json.producto}\\n   ${i.json.mensaje} | ${i.json.fecha}`\n).join('\\n')}`;\n\nreturn [{\n    json: {\n        total: items.length,\n        pendientes,\n        resueltas,\n        filas_html: filasHTML,\n        telegram: telegramMsg\n    }\n}];"
      },
