          "id": "9VBZqOBt6WDgRTdn",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "mjomlem.21@gmail.com",
        "toEmail": "={{ $('Webhook').first().json.body.email_cliente }}",
        "subject": "=Detalle de su compra #{{ $json.venta_id }}",
        "html": "=<h2>Gracias por su compra</h2>\n<p>Estimado/a <b>{{ $json.cliente }}</b>,</p>\n<p>Le confirmamos su compra del <b>{{ $json.fecha }}</b>:</p>\n<table border=\"1\" cellpadding=\"8\" style=\"border-collapse:collapse;width:100%\">\n  <tr style=\"background:#f0f0f0\">\n    <th>Producto</th>\n    <th>Cantidad</th>\n    <th>Precio</th>\n    <th>Subtotal</th>\n  </tr>\n  {{ $json.detalle.map(d => `\n  <tr>\n    <td>${d.producto}</td>\n    <td>${d.cantidad}</td>\n    <td>Q${d.precio}</td>\n    <td>Q${d.subtotal}</td>\n  </tr>`).join('') }}\n</table>\n<p><b>Total: Q{{ $json.total }}</b></p>\n<p>Gracias por preferirnos.</p>",
        "options": {}
