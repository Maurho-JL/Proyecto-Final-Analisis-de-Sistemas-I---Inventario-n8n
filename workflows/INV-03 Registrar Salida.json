    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nWITH nueva_salida AS (\n    INSERT INTO salidas (producto_id, cantidad, motivo, notas)\n    VALUES (\n        {{ $json.body.producto_id }},\n        {{ $json.body.cantidad }},\n        '{{ $json.body.motivo }}',\n        '{{ $json.body.notas }}'\n    )\n    RETURNING id, producto_id, cantidad, motivo, notas, fecha\n)\nSELECT \n    s.id,\n    s.producto_id,\n    p.nombre AS nombre_producto,\n    s.cantidad,\n    s.motivo,\n    s.notas,\n    s.fecha\nFROM nueva_salida s\nJOIN productos p ON p.id = s.producto_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
