    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    v.cliente_id,\n    cl.nombre       AS cliente,\n    v.total,\n    v.fecha::DATE   AS fecha,\n    COUNT(v.id)     AS cantidad_ventas\nFROM ventas v\nJOIN clientes cl ON cl.id = v.cliente_id\nWHERE v.fecha::DATE = CURRENT_DATE\nGROUP BY v.cliente_id, cl.nombre, v.total, v.fecha::DATE\nHAVING COUNT(v.id) > 1\nORDER BY cantidad_ventas DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "9457f26f-ca4a-4e8c-a1f6-91ca1b563094",
