    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst filasHTML = items.map((i, idx) => `\n    <tr>\n        <td>${idx + 1}</td>\n        <td>${i.json.codigo}</td>\n        <td>${i.json.producto}</td>\n        <td>${i.json.categoria}</td>\n        <td>${i.json.unidades_vendidas}</td>\n        <td>Q${parseFloat(i.json.ingresos_generados).toFixed(2)}</td>\n    </tr>\n`).join('');\n\nconst telegramMsg = ` Top 10 productos más vendidos del mes\n\n${items.map((i, idx) =>\n    `${idx+1}. ${i.json.producto}\\n   ${i.json.unidades_vendidas} uds | Q${parseFloat(i.json.ingresos_generados).toFixed(2)}`\n).join('\\n')}`;\n\nreturn [{\n    json: {\n        filas_html: filasHTML,\n        telegram: telegramMsg\n    }\n}];"
      },
