    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    c.id,\n    c.nombre                    AS cliente,\n    COUNT(v.id)                 AS total_compras,\n    COALESCE(SUM(v.total), 0)  AS total_gastado,\n    MAX(v.fecha)::DATE          AS ultima_compra,\n    CASE\n        WHEN COUNT(v.id) >= 5 THEN 'VIP'\n        WHEN COUNT(v.id) >= 3 THEN 'frecuente'\n        WHEN COUNT(v.id) >= 1 THEN 'ocasional'\n        ELSE 'sin compras'\n    END                         AS categoria_cliente\nFROM clientes c\nLEFT JOIN ventas v ON v.cliente_id = c.id\nGROUP BY c.id, c.nombre\nORDER BY total_compras DESC, total_gastado DESC;",
        "options": {}
      },
