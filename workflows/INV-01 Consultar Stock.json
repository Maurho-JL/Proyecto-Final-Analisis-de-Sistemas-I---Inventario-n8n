        "operation": "executeQuery",
        "query": "SET search_path TO inventario;\n\nSELECT \n    p.id,\n    p.codigo,\n    p.nombre,\n    c.nombre        AS categoria,\n    p.precio_venta,\n    p.stock_actual,\n    p.stock_minimo,\n    p.stock_maximo,\n    CASE \n        WHEN p.stock_actual = 0               THEN 'agotado'\n        WHEN p.stock_actual <= p.stock_minimo THEN 'stock_bajo'\n        ELSE 'disponible'\n    END             AS estado\nFROM productos p\nJOIN categorias c ON c.id = p.categoria_id\nORDER BY p.id ASC;",
